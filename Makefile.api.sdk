# Config-driven SDK, CLI, and plugin API doc generator
#
# Reads [[sdks]], [[clis]], and [[plugins]] from api-packages.toml.
# Delegates actual generation to Python scripts.
#
# A shared .venv is created once by setup-venv with SDK packages and any
# extra CLI dependencies needed to generate CLI docs.
# Plugin API docs use isolated per-plugin venvs via Makefile.api.plugins.
#
# Examples:
#   make -f unionai-docs-infra/Makefile.api.sdk                       # Full build with fresh venv
#   make -f unionai-docs-infra/Makefile.api.sdk SKIP_VENV_SETUP=true  # Use current environment
#   make -f unionai-docs-infra/Makefile.api.sdk sdks                  # SDK docs only (venv must exist)
#   make -f unionai-docs-infra/Makefile.api.sdk clis                  # CLI docs only (venv must exist)
#   FLYTE_SDK_PATH=~/repos/flyte-sdk make -f unionai-docs-infra/Makefile.api.sdk  # Use local flyte-sdk

SKIP_VENV_SETUP ?= false
UV := uv run --project unionai-docs-infra

.PHONY: all
all: setup-venv sdks clis plugins clean-venv

.PHONY: setup-venv
setup-venv:
ifeq ($(SKIP_VENV_SETUP),true)
	@true
else
	@FLYTE_SDK_PATH=$(FLYTE_SDK_PATH) $(UV) unionai-docs-infra/tools/api_venv_setup.py
endif

.PHONY: sdks
sdks:
	@SKIP_VENV_SETUP=$(SKIP_VENV_SETUP) $(UV) unionai-docs-infra/tools/api_sdk_generate.py

.PHONY: clis
clis:
	@SKIP_VENV_SETUP=$(SKIP_VENV_SETUP) $(UV) unionai-docs-infra/tools/api_cli_generate.py

# Frozen plugins are SKIPPED here, matching check_versions.py and
# api_cli_generate.py. Their pages are committed content, not regenerable output:
# flyteplugins-{anthropic,gemini,openai} were removed from the SDK and their
# API-reference dirs are hand-maintained snapshots carrying a deprecation notice
# pointing at the flyteplugins-agents-* replacements.
#
# Without the skip this target still regenerates them -- it installs the last
# published version from PyPI (they are all still there, unyanked, at 2.5.8) and
# `generate` starts with `rm -rf $(OUTPUT_FOLDER)`, so the hand-written notices are
# deleted with no error and no diff anyone would read as a loss. `make dist` was
# never exposed to this because it regenerates via check_versions.py, which does
# honour `frozen`; only this target and a direct Makefile.api.plugins call bypassed
# it. (DOC-1404.)
#
# The per-plugin variant override is passed as PAGE_VARIANTS, not VARIANTS.
# Makefile.api.plugins reads PAGE_VARIANTS, and the parent exports VARIANTS as the
# unsigned BUILD list ("flyte union"). Passing VARIANTS here set a name nothing
# reads, so a plugin's override was silently dropped and union-plugin
# (-flyte +union) generated into BOTH variants. check_versions.py always passed
# the right name, so only this direct target was affected. (DOC-1394, DOC-1404)
.PHONY: plugins
plugins:
	@PLUGIN_COUNT=$$($(UV) unionai-docs-infra/tools/api_config.py plugin_count); \
	for i in $$(seq 0 $$((PLUGIN_COUNT - 1))); do \
		PLUGIN=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i plugin); \
		TITLE=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i title); \
		NAME=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i name); \
		FROZEN=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i frozen 2>/dev/null); \
		if [ "$$FROZEN" = "true" ]; then \
			echo "Skipping $$NAME: frozen (committed content)"; \
			continue; \
		fi; \
		OF=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i output_folder 2>/dev/null); \
		WT=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i weight 2>/dev/null); \
		VAR=$$($(UV) unionai-docs-infra/tools/api_config.py plugin $$i variants 2>/dev/null); \
		echo "Generating plugin docs: $$NAME ($$PLUGIN)$${OF:+ -> $$OF}"; \
		$(MAKE) -f unionai-docs-infra/Makefile.api.plugins \
			PLUGIN="$$PLUGIN" TITLE="$$TITLE" NAME="$$NAME" \
			$${OF:+OUTPUT_FOLDER="$$OF"} $${WT:+WEIGHT="$$WT"} $${VAR:+PAGE_VARIANTS="$$VAR"} \
			SKIP_VENV_SETUP=false; \
	done

.PHONY: clean-venv
clean-venv:
ifeq ($(SKIP_VENV_SETUP),true)
	@true
else
	@rm -rf .venv && echo "Cleaned up venv."
endif

.PHONY: clean
clean:
	@$(UV) unionai-docs-infra/tools/clean_generated.py

.PHONY: help
help:
	@echo "Config-driven SDK and CLI API Doc Generator"
	@echo ""
	@echo "Reads [[sdks]] and [[clis]] from api-packages.toml."
	@echo "Creates a shared venv with SDK packages and CLI extras."
	@echo "Plugin API docs use isolated per-plugin venvs."
	@echo ""
	@echo "Targets:"
	@echo "  all       - Set up venv, generate SDK, CLI, and plugin docs, clean up (default)"
	@echo "  setup-venv - Create shared venv with SDK packages and CLI extras"
	@echo "  sdks      - Generate SDK API docs (venv must exist)"
	@echo "  clis      - Generate CLI docs (venv must exist)"
	@echo "  plugins   - Generate all plugin API docs in isolated per-plugin venvs"
	@echo "  clean-venv - Remove the shared venv"
	@echo "  clean     - Remove all generated SDK/CLI/plugin content"
	@echo ""
	@echo "Options:"
	@echo "  SKIP_VENV_SETUP=true  - Skip automatic venv setup and use current environment"
	@echo "  FLYTE_SDK_PATH=<path> - Use local flyte-sdk checkout instead of PyPI"
