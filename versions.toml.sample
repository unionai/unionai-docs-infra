# Docs version plan (DOC-1245, docs-versioning "A2" model).
# The real file lives at the unionai-docs repo ROOT (version-specific config,
# alongside makefile.inc / api-packages.toml), NOT here in infra.
#
# The production build (build_versions.sh) assembles one dist serving every
# v2-line version under /docs/<version>/:
#   /docs/latest  <- main            NOINDEX   (bleeding edge)
#   /docs/v2      <- the `stable` tag INDEXED   (canonical stable; SEO anchor)
#   /docs/<tag>   <- each enumerated  NOINDEX   (immutable pinned, cached)
# Only /docs/v2 is indexed. /docs/stable and the /docs/latest alias are
# Cloudflare redirect rules, not built here. See ROUTING-ARCHITECTURE.md.

# The tag /docs/v2 (canonical stable) is built from — the newest cut.
stable = "v2.5.12.0"

# Immutable pinned versions to build at /docs/v2.x.y.z and show in the selector.
# Maintainers add/remove entries; each MUST be an existing git tag. Newest first.
enumerated = [
  "v2.5.12.0",
  "v2.5.11.0",
]
