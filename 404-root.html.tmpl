<!DOCTYPE html>
<!-- ROOT 404 page (dist/404.html) -- DOC-1334 failure-surfaces slice.
--
-- Its EXISTENCE is the feature: with a 404.html at the output root, Cloudflare
-- Pages serves real 404s for unknown paths instead of the SPA fallback (which
-- served the landing page with a 200 -- the "200-stub" that repeatedly defeated
-- reachability checks: DOC-1331, the DOC-1333 preview probes, DOC-1335's
-- rollout probes). It also un-deadens the per-variant 404 machinery: before
-- this file existed, the fallback swallowed every miss before any 404 logic
-- could run.
--
-- Behavior: if the missed path contains a variant segment (/union/ or
-- /flyte/), forward to that variant's rich 404 page (the same contract as the
-- per-variant 404 shim: <up-to-variant>/404/?url=...), which carries the
-- styled page + the walk-up-to-nearest-parent logic. Otherwise render the
-- self-contained not-found card below.
--
-- Styling inline on purpose: a 404 page must not depend on assets that might
-- themselves be missing. -->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found &middot; Union.ai Docs</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const path = new URL(window.location).pathname;
        for (const variant of ['union', 'flyte']) {
          const i = path.indexOf('/' + variant + '/');
          if (i !== -1) {
            const target = new URL(path.substring(0, i) + '/' + variant + '/404/', window.location.origin);
            target.searchParams.set('url', document.location.toString());
            window.location.replace(target.toString());
            return;
          }
        }
      });
    </script>
    <style>
      :root {
        --bg: #ffffff; --text: #131108; --text-2: #57534e;
        --card: #fafaf9; --border: rgba(19, 17, 8, 0.12);
        --accent: #b45309;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #09090b; --text: #f7f7f5; --text-2: #a8a29e;
          --card: #131316; --border: rgba(247, 247, 245, 0.14);
          --accent: #fcb51d;
        }
      }
      html, body { height: 100%; margin: 0; }
      body {
        background: var(--bg); color: var(--text);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        display: grid; place-items: center;
      }
      .card {
        background: var(--card); border: 1px solid var(--border);
        border-radius: 12px; padding: 2.5rem 3rem; text-align: center;
        max-width: 26rem;
      }
      .code { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: var(--text-2); margin: 0 0 0.5rem; }
      h1 { font-size: 1.375rem; font-weight: 700; margin: 0 0 0.5rem; letter-spacing: -0.01em; }
      p  { font-size: 0.9rem; color: var(--text-2); line-height: 1.6; margin: 0 0 1.5rem; }
      a.button {
        display: inline-block; background: var(--accent); color: var(--bg);
        border-radius: 6px; padding: 0.55rem 1.1rem; text-decoration: none;
        font-weight: 600; font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>This page doesn&rsquo;t exist &mdash; it may have moved, or the link may be out of date.</p>
      <a class="button" href="@@BASE@@/@@DEFAULT_VARIANT@@/">Open the documentation</a>
    </div>
  </body>
</html>
