# Plugin API documentation generator
#
# Uses an isolated per-plugin venv created on demand.
#
# Examples:
#   make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE="Weights & Biases" NAME=wandb
#
# For packages available locally:
#  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE="Weights & Biases" NAME=wandb SKIP_VENV_SETUP=true
#
# Required variables:
#   PLUGIN  - Python import path (e.g., flyteplugins.wandb) used by the parser
#   TITLE   - The display title for the documentation
#   NAME    - The folder name under the plugins output base directory

# Read config from api-packages.toml
UV := uv run --project unionai-docs-infra
PLUGINS_OUTPUT_BASE := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config output_base)
PLUGINS_DEFAULT_INCLUDE := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config default_include)
PLUGINS_NO_FLATTEN := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config no_flatten)
NO_FLATTEN_FLAG := $(if $(filter true,$(PLUGINS_NO_FLATTEN)),--no-flatten true,)

# OUTPUT_FOLDER and WEIGHT may be overridden on the command line (a promoted plugin,
# e.g. union-plugin, sets both from its api-packages.toml entry).
OUTPUT_FOLDER=$(PLUGINS_OUTPUT_BASE)/${NAME}
API_DATA=/tmp/${NAME}.api.yaml
LANDING_PAGE ?= $(PLUGINS_DEFAULT_INCLUDE)
PLUGIN_VENV_DIR ?= /tmp/unionai-docs-plugin-${NAME}.venv
SKIP_VENV_SETUP ?= false
WEIGHT ?=
WEIGHT_FLAG := $(if $(WEIGHT),--weight $(WEIGHT),)

# Variant visibility for the generated pages. Defaults to both variants; a plugin
# may override it from its api-packages.toml entry (e.g. union-plugin is Union-only).
#
# NOT named VARIANTS. The parent Makefile does `export VARIANTS` from
# makefile.inc, where it means the list of variants to BUILD and is
# deliberately unsigned ("flyte union"). A `VARIANTS ?=` here loses to that
# exported value, so this makefile silently generated `variants: flyte union`
# -- unsigned, which gates every page out of every variant. (DOC-1394)
PAGE_VARIANTS ?= +flyte +union

.PHONY: all
all: check_vars setup-venv parser generate clean-venv

# A frozen plugin's pages are committed content, not regenerable output, so this
# refuses to run on one. `generate` opens with `rm -rf $(OUTPUT_FOLDER)`, and for
# flyteplugins-{anthropic,gemini,openai} that folder holds hand-written deprecation
# notices pointing at the flyteplugins-agents-* replacements. Regenerating installs
# the last published version from PyPI -- all three are still there, unyanked, at
# 2.5.8 -- and silently rewrites the pages without them. Verified by doing it: the
# notice went 1 -> 0 and make exited 0.
#
# This is the second door. Makefile.api.sdk's `plugins` loop now skips frozen
# entries, but this makefile is documented for direct per-plugin use, so it needs
# its own guard. ALLOW_FROZEN=true is the deliberate override, for the case where
# a frozen page really is meant to be rebuilt. (DOC-1404.)
ALLOW_FROZEN ?= false

.PHONY: check_vars
check_vars:
	@if [ -z "${PLUGIN}" ]; then echo "ERROR: PLUGIN is not set"; exit 1; fi
	@if [ -z "${TITLE}" ]; then echo "ERROR: TITLE is not set"; exit 1; fi
	@if [ -z "${NAME}" ]; then echo "ERROR: NAME is not set"; exit 1; fi
	@if [ "$(ALLOW_FROZEN)" != "true" ] && \
	    [ "$$($(UV) unionai-docs-infra/tools/api_config.py plugin_by_name '${NAME}' frozen 2>/dev/null)" = "true" ]; then \
		echo "ERROR: '${NAME}' is frozen in api-packages.toml -- its pages are committed content."; \
		echo "       Regenerating would overwrite them (including any hand-written deprecation notice)."; \
		echo "       Pass ALLOW_FROZEN=true if you really mean to rebuild it."; \
		exit 1; \
	fi

.PHONY: setup-venv
setup-venv: check_vars
ifeq ($(SKIP_VENV_SETUP),false)
	@REPO_ROOT="$(REPO_ROOT)" FLYTE_SDK_PATH="$(FLYTE_SDK_PATH)" $(UV) unionai-docs-infra/tools/api_plugin_venv_setup.py \
		--name "${NAME}" \
		--venv-dir "$(PLUGIN_VENV_DIR)"
else
	@true
endif

.PHONY: clean_api_data
clean_api_data:
	rm -f "${API_DATA}"

.PHONY: parser
parser: check_vars clean_api_data
ifeq ($(SKIP_VENV_SETUP),false)
	$(PLUGIN_VENV_DIR)/bin/python unionai-docs-infra/tools/api_generator/parser --package ${PLUGIN} --output ${API_DATA} --all-only
else
	unionai-docs-infra/tools/api_generator/parser --package ${PLUGIN} --output ${API_DATA} --all-only
endif

.PHONY: generate
generate: check_vars clean_output_folder
ifeq ($(SKIP_VENV_SETUP),false)
	$(PLUGIN_VENV_DIR)/bin/python unionai-docs-infra/tools/api_generator/generate \
		--name ${NAME} \
		--title "${TITLE}" \
		--api "${API_DATA}" \
		--include ${LANDING_PAGE} \
		$(NO_FLATTEN_FLAG) \
		$(WEIGHT_FLAG) \
		--short-names \
		--variants "$(PAGE_VARIANTS)" \
		--output_dir "${OUTPUT_FOLDER}"
else
	unionai-docs-infra/tools/api_generator/generate \
		--name ${NAME} \
		--title "${TITLE}" \
		--api "${API_DATA}" \
		--include ${LANDING_PAGE} \
		$(NO_FLATTEN_FLAG) \
		$(WEIGHT_FLAG) \
		--short-names \
		--variants "$(PAGE_VARIANTS)" \
		--output_dir "${OUTPUT_FOLDER}"
endif

.PHONY: clean_output_folder
clean_output_folder:
	rm -rf "${OUTPUT_FOLDER}"

.PHONY: clean-venv
clean-venv:
ifeq ($(SKIP_VENV_SETUP),false)
	rm -rf "$(PLUGIN_VENV_DIR)"
else
	@true
endif

.PHONY: clean
clean: clean_output_folder clean_api_data clean-venv

.PHONY: help
help:
	@echo "Integration API Documentation Generator"
	@echo ""
	@echo "Creates an isolated plugin venv under /tmp for each plugin build."
	@echo ""
	@echo "Usage:"
	@echo "  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=<package> TITLE=\"<title>\" NAME=<folder>"
	@echo ""
	@echo "Required variables:"
	@echo "  PLUGIN  - Python import path (e.g., flyteplugins.wandb)"
	@echo "  TITLE   - The display title for the documentation"
	@echo "  NAME    - The folder name under the plugins output base (from api-packages.toml)"
	@echo ""
	@echo "Options:"
	@echo "  SKIP_VENV_SETUP=true - Skip venv and use current environment"
	@echo ""
	@echo "Examples:"
	@echo "  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE=\"Weights & Biases\" NAME=wandb"
	@echo ""
	@echo "Targets:"
	@echo "  all              - Parse and generate (default)"
	@echo "  setup-venv       - Create an isolated plugin venv"
	@echo "  parser           - Parse plugin package to extract API data"
	@echo "  generate         - Generate documentation from API data"
	@echo "  clean_output_folder - Remove generated output folder"
	@echo "  clean-venv       - Remove the isolated plugin venv"
	@echo "  clean            - Clean output folder and API data"
