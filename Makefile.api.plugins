# Plugin API documentation generator
#
# Uses the shared .venv created by api_venv_setup.py (via Makefile.api.sdk setup-venv).
# All plugin packages are pre-installed in the shared venv.
#
# Examples:
#   make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE="Weights & Biases" NAME=wandb
#
# For packages available locally:
#  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE="Weights & Biases" NAME=wandb SKIP_VENV_SETUP=true
#
# Required variables:
#   PLUGIN  - Python import path (e.g., flyteplugins.wandb) used by the parser
#   TITLE   - The display title for the documentation
#   NAME    - The folder name under the plugins output base directory

# Read config from api-packages.toml
UV := uv run --project unionai-docs-infra
PLUGINS_OUTPUT_BASE := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config output_base)
PLUGINS_DEFAULT_INCLUDE := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config default_include)
PLUGINS_NO_FLATTEN := $(shell $(UV) unionai-docs-infra/tools/api_config.py plugins_config no_flatten)
NO_FLATTEN_FLAG := $(if $(filter true,$(PLUGINS_NO_FLATTEN)),--no-flatten true,)

OUTPUT_FOLDER=$(PLUGINS_OUTPUT_BASE)/${NAME}
API_DATA=/tmp/${NAME}.api.yaml
LANDING_PAGE ?= $(PLUGINS_DEFAULT_INCLUDE)
VENV_DIR=.venv
SKIP_VENV_SETUP ?= false

.PHONY: all
all: check_vars parser generate

.PHONY: check_vars
check_vars:
	@if [ -z "${PLUGIN}" ]; then echo "ERROR: PLUGIN is not set"; exit 1; fi
	@if [ -z "${TITLE}" ]; then echo "ERROR: TITLE is not set"; exit 1; fi
	@if [ -z "${NAME}" ]; then echo "ERROR: NAME is not set"; exit 1; fi
ifeq ($(SKIP_VENV_SETUP),false)
	@if [ ! -f "$(VENV_DIR)/bin/python" ]; then \
		echo "ERROR: shared venv not found at $(VENV_DIR)."; \
		echo "Run 'make -f unionai-docs-infra/Makefile.api.sdk setup-venv' first."; \
		exit 1; \
	fi
endif

.PHONY: clean_api_data
clean_api_data:
	rm -f "${API_DATA}"

.PHONY: parser
parser: check_vars clean_api_data
ifeq ($(SKIP_VENV_SETUP),false)
	$(VENV_DIR)/bin/python unionai-docs-infra/tools/api_generator/parser --package ${PLUGIN} --output ${API_DATA} --all-only
else
	unionai-docs-infra/tools/api_generator/parser --package ${PLUGIN} --output ${API_DATA} --all-only
endif

.PHONY: generate
generate: check_vars clean_output_folder
ifeq ($(SKIP_VENV_SETUP),false)
	$(VENV_DIR)/bin/python unionai-docs-infra/tools/api_generator/generate \
		--name ${NAME} \
		--title "${TITLE}" \
		--api "${API_DATA}" \
		--include ${LANDING_PAGE} \
		$(NO_FLATTEN_FLAG) \
		--short-names \
		--variants "+flyte +byoc +selfmanaged" \
		--output_dir "${OUTPUT_FOLDER}"
else
	unionai-docs-infra/tools/api_generator/generate \
		--name ${NAME} \
		--title "${TITLE}" \
		--api "${API_DATA}" \
		--include ${LANDING_PAGE} \
		$(NO_FLATTEN_FLAG) \
		--short-names \
		--variants "+flyte +byoc +selfmanaged" \
		--output_dir "${OUTPUT_FOLDER}"
endif

.PHONY: clean_output_folder
clean_output_folder:
	rm -rf "${OUTPUT_FOLDER}"

.PHONY: clean
clean: clean_output_folder clean_api_data

.PHONY: help
help:
	@echo "Integration API Documentation Generator"
	@echo ""
	@echo "Uses the shared .venv created by 'make -f Makefile.api.sdk setup-venv'."
	@echo ""
	@echo "Usage:"
	@echo "  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=<package> TITLE=\"<title>\" NAME=<folder>"
	@echo ""
	@echo "Required variables:"
	@echo "  PLUGIN  - Python import path (e.g., flyteplugins.wandb)"
	@echo "  TITLE   - The display title for the documentation"
	@echo "  NAME    - The folder name under the plugins output base (from api-packages.toml)"
	@echo ""
	@echo "Options:"
	@echo "  SKIP_VENV_SETUP=true - Skip venv and use current environment"
	@echo ""
	@echo "Examples:"
	@echo "  make -f unionai-docs-infra/Makefile.api.plugins PLUGIN=flyteplugins.wandb TITLE=\"Weights & Biases\" NAME=wandb"
	@echo ""
	@echo "Targets:"
	@echo "  all              - Parse and generate (default)"
	@echo "  parser           - Parse plugin package to extract API data"
	@echo "  generate         - Generate documentation from API data"
	@echo "  clean_output_folder - Remove generated output folder"
	@echo "  clean            - Clean output folder and API data"
